{
  "manifest_version": 3,
  "name": "Root CA Tracker",
  "version": "1.1.0",
  "description": "Shows which root certificate authorities your HTTPS connections actually use, highlights roots that aren't built in (possible traffic inspection), and compares them with Mozilla's root list.",
  "homepage_url": "https://github.com/hashier/root-ca-tracker",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "ccadb.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Root CA Tracker",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "root-ca-tracker@loessl.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
